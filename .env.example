# 복지그루 — 환경변수
#
# 이 파일을 .env.local 로 복사해서 값을 채운다. .env* 는 커밋되지 않는다.
# Vercel 에 올릴 때는 Project → Settings → Environment Variables 에 같은 이름으로 넣는다.
#
# ⚠ 키가 없어도 화면과 규칙 계산(제도·마감일·서류·안내문 템플릿)은 그대로 동작한다.
#   AI 버튼만 「키가 설정되지 않았습니다」 안내를 낸다.

# 제미나이 API 키. https://aistudio.google.com/apikey 에서 받는다
GEMINI_API_KEY=

# 선택. 비우면 gemini-3-flash-preview 를 쓴다
GEMINI_MODEL=

# ── 아래는 Vercel 에만 넣는다 (로컬에서는 시험하지 않기로 했다) ──

# 공공데이터포털 일반 인증키 (Decoding). /api/welfare · /api/cron/sync
DATA_GO_KR_KEY=

# Supabase — 데이터 갱신 파이프라인. secret 키(sb_secret_…)를 넣는다. publishable/anon 키가 아니다
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# /api/cron/sync 를 부를 수 있는 값. 아무 긴 문자열 (예: openssl rand -hex 32)
CRON_SECRET=
